# Copy this to .env (same directory as docker-compose.yml) and fill in real
# values before running `docker compose up`. Never commit the real .env file.

POSTGRES_USER=traqo_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=traqo_prod

# Reuse the same values from Railway if you want existing login sessions to
# stay valid across the migration; otherwise generate new random strings.
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

# Your real domain once DNS is pointed at the VPS, e.g. https://traqofit.com
CORS_ORIGINS=http://localhost
